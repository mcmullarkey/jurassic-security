# Server-side environment variables - copy to .env.server
# For production on Render, set NODE_ENV=production
NODE_ENV=development
ACCESS_PASSWORD=your-access-password-here

# Question 1: T-Rex eye color (single answer)
ANSWER_TREX_EYES=your-answer-here

# Question 2: Mechanic access codes (any one of these 3 is correct)
ANSWER_MECHANIC_1=code1
ANSWER_MECHANIC_2=code2
ANSWER_MECHANIC_3=code3

# Question 3: Engineer access codes (any one of these 3 is correct)
ANSWER_ENGINEER_1=code1
ANSWER_ENGINEER_2=code2
ANSWER_ENGINEER_3=code3

# Question 4: Security Guard access codes (any one of these 3 is correct)
ANSWER_SECURITY_1=code1
ANSWER_SECURITY_2=code2
ANSWER_SECURITY_3=code3

# Question 5: Park Sponsor access codes (any one of these 3 is correct)
ANSWER_SPONSOR_1=code1
ANSWER_SPONSOR_2=code2
ANSWER_SPONSOR_3=code3

# Question 6: Janitor access codes (any one of these 3 is correct)
ANSWER_JANITOR_1=code1
ANSWER_JANITOR_2=code2
ANSWER_JANITOR_3=code3

# Question 7: Lawyer access codes (any one of these 3 is correct)
ANSWER_LAWYER_1=code1
ANSWER_LAWYER_2=code2
ANSWER_LAWYER_3=code3

# Question 8: Dinosaur Trainer access codes (any one of these 3 is correct)
ANSWER_TRAINER_1=code1
ANSWER_TRAINER_2=code2
ANSWER_TRAINER_3=code3

# Question 9: Mosquito year (single answer)
ANSWER_MOSQUITO_YEAR=your-year-here

# Question 10: Milliliters total (single answer)
ANSWER_MILLILITERS=your-ml-here

# Question 11: Lab personnel access code (single answer)
ANSWER_LAB_CODE=your-lab-code-here

SECRET_CODE=your-secret-code-here
SESSION_SECRET=your-super-secret-random-session-key-minimum-32-characters
PORT=3001